# Database Configuration
# IMPORTANT: Change the password before first run!
DB_USER=mygameshelf
DB_PASSWORD=120915le
DB_NAME=my_game_shelf

# Application Configuration
APP_PORT=8080

# CORS Configuration
# Use * to allow all origins (good for self-hosting)
# Or specify comma-separated list: http://10.0.0.45:5173,http://192.168.1.100:5173
ALLOWED_ORIGINS=*

# JWT Configuration
# IMPORTANT: Change this to a random 32+ character string before first run!
JWT_SECRET=change-me-to-a-random-32-char-secret

# SMTP Configuration (for invite emails)
# Dev: Mailpit runs via docker-compose.dev.yml — no auth needed, emails visible at http://localhost:8025
# Prod: set these to a real SMTP provider (Gmail, Mailgun, etc.)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@mygameshelf.local
APP_BASE_URL=http://localhost:5173

# Optional: Uncomment to enable debug mode
# DEBUG=true